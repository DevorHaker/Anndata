# ===================================================================
# SmartProcure (SIH26032) — Environment Configuration Template (.env.example)
# DO NOT STORE SENSITIVE PRODUCTION SECRETS IN GIT OR SOURCE REPOSITORIES
# ===================================================================

# Application Core Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
APP_VERSION=v1.0.0

# Security & Authentication Secrets (MUST CHANGE IN PRODUCTION)
JWT_SECRET=dev-smart-procure-super-secret-key-change-in-prod
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL 15)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_procure
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000

# Cache & Message Queue Configuration (Redis 7)
REDIS_URL=redis://localhost:6379

# Adapter Modes (Production Boundaries)
SMS_PROVIDER_MODE=mock
PAYMENT_PROVIDER_MODE=mock

# Feature Flags
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_VOICE_ASSISTANCE=true
FEATURE_OFFLINE_SYNC=true

# Logging & Observability
LOG_LEVEL=info
