# =============================================================================
# SMARTPROCURE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Primary Transactional Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres_password_dev@localhost:5432/smart_procure

# Auxiliary Cache & Queue Infrastructure (Redis)
REDIS_URL=redis://localhost:6379

# Cryptographic & Session Secrets (SERVER-ONLY - NEVER EXPOSE TO FRONTEND)
JWT_SECRET=dev-smart-procure-super-secret-key-change-in-prod
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=*

# Frontend Public Variables (Vite prefixed)
VITE_API_BASE_URL=http://localhost:5000/api/v1
