# ===================================================================
# SmartProcure — Environment Variables Reference
# ===================================================================
#
# FOR LOCAL DEVELOPMENT:
#   Copy this file to .env and fill in your local values.
#   Run: cp .env.example .env
#
# FOR VERCEL DEPLOYMENT:
#   Do NOT commit .env to Git.
#   Set these variables in the Vercel Dashboard:
#     Project → Settings → Environment Variables
#   Or use the Vercel CLI:
#     vercel env add DATABASE_URL production
#
# ===================================================================

# --- Application Core ------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# --- Security (REQUIRED — change before any deployment) ---------
# Must be at least 32 random characters in production
JWT_SECRET=dev-smart-procure-super-secret-key-change-in-prod
JWT_EXPIRES_IN=7d

# CORS: set to your exact Vercel domain in production
# e.g. https://smart-procure.vercel.app
# On Vercel, this is also enforced via vercel.json response headers
CORS_ORIGIN=http://localhost:3000

# --- Database (PostgreSQL 15) -----------------------------------
# Local:   postgresql://postgres:postgres@localhost:5432/smart_procure
# Vercel:  Use Vercel Postgres Add-on, Supabase, Neon, or any managed PostgreSQL
#          The connection string is injected automatically by Vercel Postgres add-on
#          as POSTGRES_URL — set DATABASE_URL to that value.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_procure

# --- Cache (Redis 7) — Optional on Vercel ----------------------
# The app gracefully degrades without Redis (rate-limit state is per-instance).
# For persistent Redis on Vercel, use Upstash Redis (free tier available):
#   https://vercel.com/integrations/upstash
# Set this to the Upstash or Redis Cloud connection string.
REDIS_URL=redis://localhost:6379

# --- Logging ----------------------------------------------------
LOG_LEVEL=info

# --- Adapter Modes (external providers) -------------------------
# SMS_PROVIDER_MODE: mock | disabled | twilio | sns
SMS_PROVIDER_MODE=mock

# PAYMENT_PROVIDER_MODE: mock | disabled | pfms | npci
PAYMENT_PROVIDER_MODE=mock

# --- Feature Flags ----------------------------------------------
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_VOICE_ASSISTANCE=true

# --- Frontend (Vite build-time variable) ------------------------
# On Vercel this is NOT needed — the frontend and API share the same domain,
# so the default "/api/v1" base URL works automatically.
# Only set this if you host the backend separately.
# VITE_API_BASE_URL=https://your-backend.railway.app/api/v1
